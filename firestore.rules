rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Neutrix admins. They can read ONLY contact cards (email, phone, gender) and feedback.
    // The email must be verified (Google sign-in is), so nobody can pose as an
    // admin by signing up with an admin's email and a password.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['altlol2102@gmail.com', 'ajay21022010@gmail.com', 'lingesh.ganesh2@gmail.com', 'adamspencer.miranda2010@gmail.com', 'abcd6162@gmail.com'];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- Each person's own data ----------
    // Only the owner can read or write anything here (medical records, plans, readings...).
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
    // ---------- Contact card: ONLY email, phone and gender (the only things admins can see about a person) ----------
    match /contacts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'phone', 'gender', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && (!('gender' in request.resource.data) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 20))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // ---------- Ratings and problem reports ----------
    // Anyone (signed in or not) can send one; only admins can read or delete them.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'rating', 'message', 'page', 'uid', 'email', 'name', 'lang', 'device', 'createdAt'])
        && request.resource.data.kind in ['rating', 'report']
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.page is string && request.resource.data.page.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.device is string && request.resource.data.device.size() <= 300
        && request.resource.data.lang in ['English', 'Malayalam']
        && request.resource.data.createdAt == request.time
        // can't pretend to be someone else
        && ((request.auth == null && request.resource.data.uid == '' && request.resource.data.email == '')
            || (request.auth != null && request.resource.data.uid == request.auth.uid
                && (request.resource.data.email == '' || request.resource.data.email == request.auth.token.email)));
      allow read, delete: if isAdmin();
    }
  }
}
