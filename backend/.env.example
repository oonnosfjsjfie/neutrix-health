# Copy this file, rename the copy to ".env", and fill in your own values.
# Never put real keys or passwords in this example file.
GEMINI_API_KEY=paste_your_key_here

# Doctor Brief email - option 1 (works on Render): Google Apps Script web app
# (see email-script/Code.gs)
NEUTRIX_MAIL_WEBHOOK=paste_web_app_url_ending_in_exec
NEUTRIX_MAIL_TOKEN=paste_the_same_secret_word

# Doctor Brief email - option 2 (works on your own computer): Gmail app password
NEUTRIX_EMAIL=your_team_account@gmail.com
NEUTRIX_EMAIL_PASSWORD=paste_app_password_here
